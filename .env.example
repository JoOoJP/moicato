# Copie para .env.local e preencha.

# Neon Postgres — use a connection string "pooled" do painel do Neon.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Neon Auth (painel /admin). BASE_URL vem do `neon env pull`;
# o segredo é seu: openssl rand -base64 32
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.c-8.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (fotos do painel) — vêm do `neon env pull`/`neon deploy`.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Pagamento — Asaas (vendas só abrem com ASAAS_API_KEY + frete configurado)
# ASAAS_ENV=sandbox            # ou production
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=         # mesmo token configurado no webhook do Asaas

# Frete — Melhor Envio
# MELHORENVIO_ENV=sandbox      # ou production
# MELHORENVIO_TOKEN=
# MELHORENVIO_CONTACT_EMAIL=contato@moikato.com.br
# SHIP_FROM_CEP=               # CEP de onde as peças saem

# E-mails transacionais — Resend (pedido confirmado, enviado, aviso de pedido novo)
# RESEND_API_KEY=
# EMAIL_FROM=Moikato <nao-responda@moikato.com>   # no-reply, domínio verificado no Resend
# EMAIL_REPLY_TO=                              # padrão: COMPANY.serviceEmail
# ORDER_NOTIFY_EMAIL=                          # quem recebe "pedido novo" (vírgula p/ vários)

# Opcionais (já existentes)
# NEXT_PUBLIC_SITE_URL=https://moikato.com
# NEXT_PUBLIC_WHATSAPP_PHONE=55DDDNUMERO
# NEXT_PUBLIC_INSTAGRAM=@moikato
# NEXT_PUBLIC_EMAIL=contato@moikato.com.br
